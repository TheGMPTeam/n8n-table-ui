    {
      "id": "Build prompt",
      "name": "Build prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1024,
        -16
      ],
      "parameters": {
        "jsCode": "const job=$('Loop jobs').item.json;\nconst tpls=$input.all().map(i=>i.json);\nif(tpls.length!==1){throw new Error('template for type '+job.type+' found: '+tpls.length);}\nlet wf; try{wf=JSON.parse(tpls[0].API);}catch(e){throw new Error('template API is not json: '+e.message);}\nlet params={}; try{params=job.params?JSON.parse(job.params):{};}catch(e){throw new Error('job params is not json');}\nif(params.prompt){let hit=false; for(const id of Object.keys(wf)){const n=wf[id]; if(!hit&&n.class_type==='CLIPTextEncode'){n.inputs.text=String(params.prompt);hit=true;}}}\nif(params.image){for(const id of Object.keys(wf)){if(wf[id].class_type==='LoadImage')wf[id].inputs.image=String(params.image);}}\nif(params.seed!==undefined){for(const id of Object.keys(wf)){if(wf[id].class_type==='KSampler'){wf[id].inputs.seed=Number(params.seed);wf[id].inputs.randomize_seed=false;}}}\nconst gpuTarget=job.type==='Upscale 4x'?'cuda:0':'cuda:1';const gpuNodes=[];for(const [nodeId,node] of Object.entries(wf)){if(node&&typeof node.class_type==='string'&&node.class_type.endsWith('MultiGPU')&&node.inputs&&Object.prototype.hasOwnProperty.call(node.inputs,'device')){node.inputs.device=gpuTarget;gpuNodes.push(nodeId+':'+node.class_type);}}if(!gpuNodes.length&&job.type!=='Upscale 4x')throw new Error('template has no supported MultiGPU device-aware loader nodes');return [{json:{rowId:job.id,jobId:job.JobID||String(job.id),promptGraph:wf,gpuTarget,gpuNodes}}];"
      }
    },

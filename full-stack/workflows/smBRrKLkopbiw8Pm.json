      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2368,
        -160
      ],
      "parameters": {
        "jsCode": "const ctx=$('Save exec id').item.json;\nconst e=$json[ctx.promptId];\nif(!e){return [{json:{...ctx,done:false,failed:false,url:'',error:''}}];}\nconst st=e.status&&e.status.status_str;\nif(st==='error'){let m='';for(const msg of (e.status.messages||[])){if(msg[0]==='execution_error'){m=msg[1].exception_message||'execution error';}}return [{json:{...ctx,done:true,failed:true,url:'',error:m.slice(0,300)}}];}\nif(st==='success'){let url='';for(const o of Object.values(e.outputs||{})){const im=o.images||[];if(im.length){url='http://10.0.0.157:8188/view?filename='+encodeURIComponent(im[0].filename)+'&type=output';}}return [{json:{...ctx,done:true,failed:false,url,error:''}}];}\nreturn [{json:{...ctx,done:false,failed:false,url:'',error:''}}];"
      }

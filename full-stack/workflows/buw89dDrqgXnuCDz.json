    {
      "id": "d58a580d-9c8c-4259-9164-65433bc2d97e",
      "name": "Validate Terminal Lock Ownership",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1792,
        0
      ],
      "parameters": {
        "jsCode": "const c=$('Capture Exact Failed Lock').first().json;const l=$json;if(l.id!==c.lockId||String(l.workflow)!==c.workflowId||l.rowId!==c.currentId)return [];if(l.executionId!=null && String(l.executionId)!==c.executionId)return [];if(l.executionId==null && c.hasActiveOwnerWorkflow)return [];return [{json:{...l,_context:c}}];"
      }
    }

    {
      "id": "b77da78c-d9cc-459e-be93-9e4a1c7614b5",
      "name": "Capture Exact Failed Lock",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1344,
        0
      ],
      "parameters": {
        "jsCode": "const scope=$('Validate Failure Scope').first().json;const e=$('Read Failed Execution').first().json;if(String(e.workflowId)!==scope.workflowId||String(e.id)!==scope.executionId)throw new Error('Execution ownership mismatch');if(!['error','crashed','canceled'].includes(e.status)||!e.stoppedAt||e.waitTill)return [];const lists=['Read Active Executions','Read Waiting Executions','Read Queued Executions'].map(n=>$(n).first().json);if(lists.some(l=>l.nextCursor||!Array.isArray(l.data)))return [];const active=lists.flatMap(l=>l.data);if(active.some(x=>String(x.id)===scope.executionId))return [];const run=e.data?.resultData?.runData||{};const captured=run['Capture Acquired Lock']||[];let c=null;\nif(captured.length){const last=captured[captured.length-1];const items=(last.data?.main?.[0]||[]).map(i=>i.json._context).filter(Boolean);if(items.length!==1)return [];c=items[0];}\nelse {const legacyName=scope.workflowId==='MZK3Pv01FHqZbooz'?'Set Running ID':'Insert row';const entries=run[legacyName]||[];if(!entries.length)return [];const items=(entries[entries.length-1].data?.main?.[0]||[]).map(i=>i.json);if(items.length!==1)return [];const l=items[0];c={workflowId:String(l.workflow),currentId:l.rowId,lockId:l.id,source:'legacy',executionId:scope.executionId};}\nif((c.executionId!==undefined && String(c.executionId)!==scope.executionId)||c.workflowId!==scope.workflowId||!Number.isSafeInteger(c.currentId)||c.currentId<=0||!Number.isSafeInteger(c.lockId)||c.lockId<=0)return [];return [{json:{...c,rowId:c.currentId,executionId:scope.executionId,eventworkflowId:scope.workflowId,tableId:scope.tableId,hasActiveOwnerWorkflow:active.some(x=>String(x.workflowId)===scope.workflowId)}}];"
      }
    },

    {
      "id": "fe54ae60-36ce-45f2-ab08-b4d7776aa096",
      "name": "Code in JavaScript",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -6352,
        -752
      ],
      "parameters": {
        "jsCode": "const __contractInputs=$input.all();\nconst __contractOutput=(()=>{\nfor (const item of $input.all()) {\n  item.json.LoopID= $input.first().json.id;\n}\nreturn $input.all();\n})();\nreturn __contractOutput.map((item,index)=>{const original=__contractInputs.indexOf(item);return {...item,pairedItem:original>=0?{item:original}:(item.pairedItem??(__contractOutput.length===__contractInputs.length?{item:index}:__contractInputs.map((_,item)=>({item}))))};});"
      }
    },
    {
      "id": "af90871e-f24a-471b-b3c6-5685719432de",

    {
      "id": "8a35bda4-de4c-4678-bd13-fd7be4e4e4d7",
      "name": "Capture AI Event",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -5184,
        -752
      ],
      "parameters": {
        "jsCode": "const sample={\"title\": \"\", \"alternate_titles\": [\"\", \"\", \"\"], \"total_duration_seconds\": 0, \"hook\": \"\", \"setup\": \"\", \"main_content\": \"\", \"payoff\": \"\", \"cta\": \"\", \"full_voiceover\": \"\", \"scenes\": [{\"scene_id\": 1, \"duration_seconds\": 0, \"script_section\": \"hook\", \"what_happens\": \"\", \"viewer_takeaway\": \"\", \"visual_concept\": \"\", \"voiceover\": \"\", \"on_screen_text\": [], \"dialogue\": [], \"sound_design\": \"\", \"transition\": \"\"}]};\nfunction check(value,shape,path){\n if(Array.isArray(shape)){if(!Array.isArray(value))throw new Error(path+' must be an array');if(shape.length&&value.length===0&&path.endsWith('scenes'))throw new Error(path+' must not be empty');if(shape.length)for(let i=0;i<value.length;i++)check(value[i],shape[0],path+'['+i+']');return;}\n if(shape&&typeof shape==='object'){if(!value||typeof value!=='object'||Array.isArray(value))throw new Error(path+' must be an object');for(const k of Object.keys(shape)){if(!Object.prototype.hasOwnProperty.call(value,k))throw new Error(path+'.'+k+' required; no synthesized defaults');check(value[k],shape[k],path+'.'+k);}return;}\n if(typeof value!==typeof shape||(typeof value==='number'&&!Number.isFinite(value)))throw new Error(path+' has invalid type');\n}\nreturn $input.all().map((item,index)=>{\n const start=$('Start AI Timing').item.json._aiStartedAt;\n let valid=true,error='';try{check(item.json.output,sample,'output');\n const s=item.json.output;\n if(!Array.isArray(s.scenes)||!s.scenes.length)throw new Error('Script scenes missing');\n let total=0;for(let i=0;i<s.scenes.length;i++){const c=s.scenes[i];if(c.scene_id!==i+1)throw new Error('Script scene IDs/order invalid');if(typeof c.duration_seconds!=='number'||!Number.isFinite(c.duration_seconds)||c.duration_seconds<=0)throw new Error('Script scene duration invalid');total+=c.duration_seconds;}\n const idea=String($('Loop Over Items').item.json.Ideas??'');\n const requested=idea.match(/\\b(\\d+(?:\\.\\d+)?)\\s*[- ]second\\b/i);\n const explicit=requested?Number(requested[1]):null;\n if(total!==s.total_duration_seconds||total>60||total<=0||(explicit!==null?total!==explicit:total<45))throw new Error('Script duration must match explicit requested seconds, otherwise 45-60s');\n if(s.scenes.map(c=>c.voiceover).join(' ').trim().split(/\\s+/).join(' ')!==s.full_voiceover.trim().split(/\\s+/).join(' '))throw new Error('full_voiceover does not match scene narration');\nif(item.json.output.full_voiceover!==undefined&&!item.json.output.full_voiceover.trim())throw new Error('full_voiceover is empty');}catch(e){valid=false;error=e.message;}\n const row=$('Capture Acquired Lock').item.json;\n return {json:{...item.json,_aiMetric:{JobID:String(row.JobID??row._context.currentId),Task:String($workflow.name),ExecutionID:String($execution.id),DurationMs:Math.max(0,Date.now()-start),ValidOutput:valid,Error:error}},pairedItem:{item:index}};\n});"
      }
    },

      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -4512,
        -752
      ],
      "parameters": {
        "jsCode": "const __contractInputs=$input.all();\nconst __contractOutput=(()=>{\nfor (const item of $input.all()) {\n  item.json.Script= JSON.stringify($input.first().json.output);\n}\nreturn $input.all();\n})();\nreturn __contractOutput.map((item,index)=>{const original=__contractInputs.indexOf(item);return {...item,pairedItem:original>=0?{item:original}:(item.pairedItem??(__contractOutput.length===__contractInputs.length?{item:index}:__contractInputs.map((_,item)=>({item}))))};});"
      }

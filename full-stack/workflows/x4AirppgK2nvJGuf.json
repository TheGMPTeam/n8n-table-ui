      "parameters": {
        "jsCode": "const __contractInputs=$input.all();\nconst __contractOutput=(()=>{\nreturn $input.all().filter(item => Number.isSafeInteger(item.json.id) && item.json.id > 0 && item.json.Working !== true);\n})();\nreturn __contractOutput.map((item,index)=>{const original=__contractInputs.indexOf(item);return {...item,pairedItem:original>=0?{item:original}:(item.pairedItem??(__contractOutput.length===__contractInputs.length?{item:index}:__contractInputs.map((_,item)=>({item}))))};});"
      }
    },
    {
      "id": "44256d85-b668-4bde-b777-3fee2f892cef",
      "name": "Canonical scheduled stage gate",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "alwaysOutputData": true,
      "position": [
        -7920,
        -352
      ],
      "parameters": {
        "jsCode": "const __contractInputs=$input.all();\nconst __contractOutput=(()=>{\nconst allowed = new Set([\"Research\", \"ReSearch\", \"research\", \"Ideas\", \"ideas\"]);\nreturn $input.all().flatMap((item, index) => { const r = item.json; return r && Number.isSafeInteger(r.id) && r.id > 0 && allowed.has(r.Type) && r.Completed === false && r.Working === false ? [{json:r, pairedItem:{item:index}}] : []; });\n})();\nreturn __contractOutput.map((item,index)=>{const original=__contractInputs.indexOf(item);return {...item,pairedItem:original>=0?{item:original}:(item.pairedItem??(__contractOutput.length===__contractInputs.length?{item:index}:__contractInputs.map((_,item)=>({item}))))};});"
      }
    },
    {
      "id": "c7f1c1ba-4724-4642-9cb0-4fb35579d033",
      "name": "Normalize Bypass Context",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -8144,
        -752
      ],
      "parameters": {
        "jsCode": "const __contractInputs=$input.all();\nconst __contractOutput=(()=>{\nconst raw={...($json.query||{}),...($json.body||{})};if(![true,'true'].includes(raw.ByPass))throw new Error('invalid_request: ByPass true required');const values=[raw.Id,raw.Row,raw.RowID].filter(v=>v!==undefined);const s=String(values[0]??'');if(!/^[1-9][0-9]*$/.test(s)||!Number.isSafeInteger(Number(s))||values.some(v=>String(v)!==s))throw new Error('invalid_request: Id must be one positive safe decimal row ID');if(raw.ByPass!==undefined && ![true,'true'].includes(raw.ByPass))throw new Error('invalid_request: ByPass must be true');return [{json:{workflowId:String($workflow.id),currentId:Number(s),lockId:null,source:'webhook',ByPass:true}}];\n})();\nreturn __contractOutput.map((item,index)=>{const original=__contractInputs.indexOf(item);return {...item,pairedItem:original>=0?{item:original}:(item.pairedItem??(__contractOutput.length===__contractInputs.length?{item:index}:__contractInputs.map((_,item)=>({item}))))};});"
      }
    },
    {
      "id": "47033f04-5d6f-4ceb-a1bc-dfd0262efc79",
      "name": "Capture Internal Context",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -7248,
        -752
      ],
      "parameters": {
        "jsCode": "const __contractInputs=$input.all();\nconst __contractOutput=(()=>{\nconst row=$json;if(!Number.isSafeInteger(row.id)||row.id<=0)throw new Error('Invalid selected row');const source=$('Normalize Bypass Context').isExecuted?'webhook':'schedule';if(source==='webhook'&&row.id!==$('Normalize Bypass Context').first().json.currentId)throw new Error('Selected row mismatch');return [{json:{...row,_context:{workflowId:String($workflow.id),currentId:row.id,lockId:null,source,executionId:String($execution.id)}}}];\n})();\nreturn __contractOutput.map((item,index)=>{const original=__contractInputs.indexOf(item);return {...item,pairedItem:original>=0?{item:original}:(item.pairedItem??(__contractOutput.length===__contractInputs.length?{item:index}:__contractInputs.map((_,item)=>({item}))))};});"
      }
    },
    {
      "id": "c20fbca5-4da2-4f16-b9e1-f0f6a1a9ec34",
      "name": "Capture Acquired Lock",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -6800,
        -752
      ],
      "parameters": {
        "jsCode": "const __contractInputs=$input.all();\nconst __contractOutput=(()=>{\nconst row=$('Capture Internal Context').item.json;const c=row._context;const lock=$json;if(!Number.isSafeInteger(lock.id)||lock.id<=0||String(lock.workflow)!==c.workflowId||lock.rowId!==c.currentId||String(lock.executionId)!==c.executionId)throw new Error('Acquired lock ownership mismatch');return [{json:{...row,_context:{...c,lockId:lock.id}}}];\n})();\nreturn __contractOutput.map((item,index)=>{const original=__contractInputs.indexOf(item);return {...item,pairedItem:original>=0?{item:original}:(item.pairedItem??(__contractOutput.length===__contractInputs.length?{item:index}:__contractInputs.map((_,item)=>({item}))))};});"
      }
    },

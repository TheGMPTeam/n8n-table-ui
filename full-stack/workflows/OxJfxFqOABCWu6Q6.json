    {
      "id": "f9d89bcb-fc5e-481d-bd0d-1fbddee594a5",
      "name": "Prepare dependency producers",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "jsCode": "const jobs=$('When Executed by Another Workflow').first().json.jobs;const templates=$input.all().map(i=>i.json);const result=(()=>{\nif(!Array.isArray(jobs)||!jobs.length)throw Error('No jobs supplied');\nconst metadata=new Map(templates.map(t=>[t.type,t]));const images=[],videos=[];\nconst parse=v=>typeof v==='string'?JSON.parse(v):v;\nfor(const job of jobs){const t=metadata.get(job.type);if(!t||!t.Dependencies)throw Error('Unconfigured template '+job.type);const d=parse(t.Dependencies);if(d.version!==1||!Array.isArray(d.inputs))throw Error('Invalid template Dependencies');const p=parse(job.Params);if(!p||!p.scene_id)throw Error('Missing scene linkage');if(!String(job.prompt||'').trim())throw Error('Missing job prompt');const normalized={...job,JobID:String(job.JobID),Dependencies:JSON.stringify({version:1,inputs:[]})};(d.inputs.length?videos:images).push(normalized);}\nfor(const job of videos){const d=parse(metadata.get(job.type).Dependencies);const p=parse(job.Params);const prerequisites=[];for(const input of d.inputs){const found=images.filter(i=>{const pp=parse(i.Params);return i.type===input.producerType&&i.JobID===job.JobID&&pp.scene_id===p.scene_id&&pp.frame_role===input.role;});if(found.length!==1)throw Error('Missing or ambiguous prerequisite producer for '+job.type+' scene '+p.scene_id+' role '+input.role);prerequisites.push({role:input.role,producerType:input.producerType,scene_id:p.scene_id});}job._prerequisites=prerequisites;}\nif(!images.length)throw Error('No image producers; dependency-first insertion required');\nreturn {images,videos};\n\n})();return [{json:result,pairedItem:$input.all().map((_,item)=>({item}))}];"
      }
    },

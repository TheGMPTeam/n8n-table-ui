    {
      "id": "052f7150-16f8-4903-89f8-d7d41a70c236",
      "name": "Bind inserted prerequisite IDs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "jsCode": "const prepared=$('Prepare dependency producers').first().json;const rows=$input.all().map(i=>i.json);const videos=prepared.videos.map(job=>{const inputs=job._prerequisites.map(edge=>{const parents=rows.filter(r=>{const p=JSON.parse(r.Params);return r.type===edge.producerType&&String(r.JobID)===job.JobID&&p.scene_id===edge.scene_id&&p.frame_role===edge.role;});if(parents.length!==1||!Number.isSafeInteger(parents[0].id)||parents[0].id<=0)throw Error('Native inserted prerequisite ID missing or ambiguous');return {role:edge.role,rowId:parents[0].id};});const {_prerequisites,...rest}=job;return {...rest,Dependencies:JSON.stringify({version:1,inputs})};});return [{json:{videos,insertedImages:rows.length},pairedItem:$input.all().map((_,item)=>({item}))}];"
      }
    },
